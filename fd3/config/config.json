{
  "_README": [
    "Settings for one book. See README.md ('Start a book') and BUILD.md ('Another book').",
    "Every key marked TODO below is empty on purpose and needs this book's value.",
    "environment_settings is the template's inheritance: the environments, counters and",
    "colours both existing books use. Change it only if this book really needs to.",
    "reading-paths declares this book's readers; see README.md ('Reading paths')."
  ],
  "_TODO": [
    "repo-url",
    "issues-url",
    "deploy-repo",
    "deploy-domain",
    "deploy-push-url"
  ],
  "title": "Number Systems: From \\(\\nN\\) to \\(\\nR\\)",
  "author": "Akizumi",
  "output": {
    "html": "_build/html",
    "pdf": "_build/pdf",
    "book": "_build/pdf/book.pdf"
  },
  "environment_settings": {
    "big_envs": [
      {
        "prefix": "thm",
        "name": "Theorem",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "lem",
        "name": "Lemma",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "cor",
        "name": "Corollary",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "prp",
        "name": "Proposition",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "ax",
        "name": "Axiom",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "cnj",
        "name": "Conjecture",
        "numbered": false,
        "color": "#6b6f7a"
      },
      {
        "prefix": "def",
        "name": "Definition",
        "numbered": true,
        "counter_group": "definition",
        "color": "#b0414f"
      },
      {
        "prefix": "exm",
        "name": "Example",
        "numbered": false,
        "color": "#3b7a4c"
      },
      {
        "prefix": "exr",
        "name": "Exercise",
        "numbered": false,
        "color": "#a8670c"
      }
    ],
    "small_envs": [
      "remark",
      "proof",
      "solution",
      "claim",
      "proofofclaim",
      "algorithm",
      "idea",
      "warning",
      "check"
    ]
  },
  "reading-paths": [],
  "chapters": [
    "src/ch01-zf-and-natural-numbers",
    "src/ch02-integers-and-rationals",
    "src/ch03-divisibility-and-congruences",
    "src/ch04-ordered-field-sequences",
    "src/ch05-reals-from-cauchy",
    "src/ch06-complete-ordered-field",
    "src/ch07-reals-dedekind-cuts"
  ],
  "macros": "../latex/macros.tex",
  "deploy-dir": "site",
  "deploy-repo": "",
  "deploy-domain": "",
  "deploy-push-url": "",
  "repo-url": "",
  "issues-url": "",
  "redirects": {},
  "license": {
    "name": "CC BY-NC-SA 4.0",
    "url": "https://creativecommons.org/licenses/by-nc-sa/4.0/"
  },
  "checks": [
    {
      "tool": "../tools/check_structure.py",
      "requires": "../authoring/STYLE.md"
    },
    {
      "tool": "../tools/check_fitch.py",
      "prefix": "fitch"
    },
    {
      "tool": "../tools/check_numbers.py",
      "requires": "verify",
      "prefix": "numbers"
    }
  ],
  "mention-exempt-titles": [
    "Characteristic Property of Pairs",
    "Integer Part"
  ],
  "external-books": {
    "fd1": {
      "title": "Logic and Proof",
      "short": "F1",
      "url": "https://akizumifox.github.io/math-atlas/fd1/",
      "labels": "../fd1/_build/crossref_labels.json"
    },
    "fd2": {
      "title": "Sets and Functions",
      "short": "F2",
      "url": "https://akizumifox.github.io/math-atlas/fd2/",
      "labels": "../fd2/_build/crossref_labels.json"
    },
    "an1": {
      "title": "Analysis on the Real Line",
      "short": "AN1",
      "url": "https://akizumifox.github.io/math-atlas/an1/",
      "labels": "../../analysis-series/an1/_build/crossref_labels.json"
    },
    "la": {
      "title": "Linear Algebra",
      "short": "LA",
      "url": "https://linear-algebra.akizumifox.com/",
      "labels": "../../linear-algebra/_build/crossref_labels.json"
    }
  }
}
